{
  "manifest_version": 3,
  "name": "TimeFrame — Find Free Time",
  "short_name": "TimeFrame",
  "version": "0.1.3",
  "description": "See the best times your group is free this week, right from your toolbar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TimeFrame",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://calender-app-mm4q.onrender.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.timeframecalender.com/*", "https://timeframecalender.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
