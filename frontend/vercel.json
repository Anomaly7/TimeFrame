{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://calender-app-mm4q.onrender.com/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://calender-app-mm4q.onrender.com/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
